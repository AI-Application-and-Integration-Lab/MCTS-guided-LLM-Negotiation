# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Only needed when you drive the simulated opponent (or the DMNA critic /
# ICL-AIF feedback model) through a hosted API instead of the local vLLM
# model. Purely local runs need none of these.

# Used when --seller-base-url / --critic-base-url is unset or points at OpenAI.
OPENAI_API_KEY=

# Used when the base URL points at OpenRouter, e.g.
#   --use-openai-seller --seller-base-url https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Optional: default base URL for every OpenAI-compatible client.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
